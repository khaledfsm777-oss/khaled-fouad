{
  "name": "react-example",
  "private": true,
  "version": "3.0.0",
  "type": "module",
  "main": "dist/server.cjs",
  "scripts": {
    "dev": "tsx server.ts",
    "build": "vite build && esbuild server.ts --bundle --platform=node --format=cjs --packages=external --sourcemap --outfile=dist/server.cjs",
    "start": "node server.ts",
    "preview": "vite preview",
    "clean": "rm -rf dist server.js",
    "lint": "tsc --noEmit",
    "android:sync": "npm run build && npx cap sync android",
    "android:open": "npx cap open android",
    "android:build": "npm run build && npx cap sync android && cd android && ./gradlew assembleDebug",
    "build:apk": "npm run android:sync",
    "electron:dev": "npx electron electron-main.cjs",
    "electron:build": "npm run build && npx electron-builder --win portable --ia32 --x64 --config.electronVersion=22.3.27",
    "build:win": "npm run build && npx electron-builder --win portable --x64"
  },
  "build": {
    "extraMetadata": {
      "main": "electron-main.cjs"
    },
    "appId": "com.albonyan.quran.app",
    "productName": "منظومة البنيان الرقمي للقرآن الكريم",
    "copyright": "Copyright © 2026 الباحث خالد فؤاد السيد",
    "electronVersion": "22.3.27",
    "directories": {
      "output": "release"
    },
    "win": {
      "target": [
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "public/icon.ico"
    },
    "portable": {
      "artifactName": "البنيان_الرقمي_محمول_Portable.${ext}",
      "requestExecutionLevel": "user"
    },
    "files": [
      "dist/**/*",
      "electron-main.cjs",
      "package.json"
    ]
  },
  "dependencies": {
    "@capacitor/android": "^8.5.2",
    "@capacitor/cli": "^8.5.2",
    "@capacitor/core": "^8.5.2",
    "@google/genai": "^2.4.0",
    "@tailwindcss/vite": "^4.1.14",
    "@vitejs/plugin-react": "^5.0.4",
    "docx": "^9.7.1",
    "dotenv": "^17.2.3",
    "esbuild": "^0.25.0",
    "express": "^4.21.2",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.3",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "autoprefixer": "^10.4.21",
    "sharp": "^0.35.4",
    "vite-plugin-singlefile": "^2.3.3"
  }
}
